{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "rootDirs": [".", "./apps/store/.react-router/types"]
  },
  "include": ["packages/*/src", "apps/store/app", "apps/admin/src", "vitest.setup.ts"]
}
